APP_NAME="Bitwarden Auto Backups"
APP_ENV=production
APP_DEBUG=false
# Generate with: docker compose -f compose.production.yaml run --rm --no-deps worker php artisan key:generate --show
APP_KEY=
# The address the web interface is reached at.
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# Logs go to the container output: docker compose -f compose.production.yaml logs -f worker
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bitwarden_auto_backups
DB_USERNAME=bitwarden_auto_backups
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Set to true when the web interface is served over HTTPS.
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=420
CACHE_STORE=database

# Where backups are stored. "backups" keeps them in the storage volume on this server.
BACKUP_DISK=backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

REGISTRATION_ENABLED=false
MAX_VAULTS_PER_USER=10

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Bitwarden Auto Backups"

# Only used with the "web" profile: where nginx listens on this machine.
# 127.0.0.1 keeps it off the network, for a tunnel or reverse proxy on this machine.
WEB_BIND=127.0.0.1
WEB_PORT=8080
