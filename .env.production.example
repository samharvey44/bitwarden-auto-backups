APP_NAME="Bitwarden Auto Backups"
APP_ENV=production
APP_DEBUG=false
# Generate with: docker compose -f compose.production.yaml run --rm --no-deps worker php artisan key:generate --show
APP_KEY=
# The address the web interface is reached at: https://<TS_HOSTNAME>.<your tailnet>.ts.net
APP_URL=https://bitwarden-auto-backups.your-tailnet.ts.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# Logs go to the container output: docker compose -f compose.production.yaml logs -f worker
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bitwarden_auto_backups
DB_USERNAME=bitwarden_auto_backups
DB_PASSWORD=
# The port MySQL is published on, on 127.0.0.1 only, for connecting over SSH.
# Change it if another project on this machine already uses it.
FORWARD_DB_PORT=3306

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=420
CACHE_STORE=database

# Where backups are stored. "backups" keeps them in the storage volume on this server.
BACKUP_DISK=backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

REGISTRATION_ENABLED=false
MAX_VAULTS_PER_USER=10

# Requested after every successful backup, such as the ping URL of a heartbeat
# monitoring service, so you're alerted if backups stop. Leave empty to send nothing.
BACKUP_HEARTBEAT_URL=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Bitwarden Auto Backups"

# Uncomment COMPOSE_PROFILES to run the web interface. Every command then
# includes it, so builds and updates keep it in step with the rest of the app.
# TS_HOSTNAME is the machine's name on your tailnet, which sets the web
# interface's address. The auth key is only needed until the machine has
# joined your tailnet.
# COMPOSE_PROFILES=web
TS_HOSTNAME=bitwarden-auto-backups
TS_AUTHKEY=
